   },
   {
    "type": "photo",
    "entite": "Joseph Gallieni",
    "nature": "personne",
    "tag": "GÉNÉRAL GALLIENI",
    "texte": [
     "Le gouverneur de Paris",
     "a une idée *folle* :",
