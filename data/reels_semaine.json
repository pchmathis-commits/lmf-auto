        ]
      },
      {
        "type": "carte",
        "entite": "Saint-Loup-de-Varennes",
        "tag": "SAINT-LOUP-DE-VARENNES",
        "texte": [
          "Prise depuis la fenêtre",
          "de sa *maison*,",
          "vers *1827*"
        ]
      },
      {
        "type": "texte",
        "tag": "SON SECRET",
        "texte": [
          "Une plaque d'étain",
