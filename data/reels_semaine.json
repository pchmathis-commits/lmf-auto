 {
  "date": "2026-11-29",
  "format": "francais",
  "sujet": "Nicéphore Niépce et la première photographie",
  "musique": "nostalgie",
  "scenes": [
   {
    "type": "photo",
    "entite": "Point de vue du Gras",
    "nature": "oeuvre",
    "texte": [
     "La plus ancienne *photo*",
     "du monde est *française* :",
     "signée *Nicéphore Niépce*"
    ],
    "tag": "NICÉPHORE NIÉPCE"
   },
   {
    "type": "photo",
    "entite": "Nicéphore Niépce",
    "nature": "personne",
    "tag": "CHALON-SUR-SAÔNE",
    "texte": [
     "Un inventeur",
     "de *Chalon-sur-Saône*,",
     "né en *1765*"
    ]
   },
   {
    "type": "carte",
    "entite": "Saint-Loup-de-Varennes",
    "tag": "SAINT-LOUP-DE-VARENNES",
    "texte": [
     "Prise depuis la fenêtre",
     "de sa *maison*,",
     "vers *1827*"
    ]
   },
   {
    "type": "texte",
    "tag": "SON SECRET",
    "texte": [
     "Une plaque d'étain",
     "couverte de *bitume*",
     "exposée à la *lumière*"
    ]
   },
   {
    "type": "texte",
    "tag": "TEMPS DE POSE",
    "texte": [
     "Des *heures*…",
     "peut-être même",
     "des *jours*"
    ]
   },
   {
    "type": "texte",
    "tag": "1952",
    "texte": [
     "L'image est *oubliée*,",
     "puis retrouvée",
     "en *1952*"
